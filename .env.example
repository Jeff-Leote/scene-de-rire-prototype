# Copie ce fichier en ".env" à la racine du projet et renseigne tes propres valeurs.
# Ce fichier .env.example ne contient aucun secret et peut être committé.

# Base de données (dev local uniquement)
DB_ROOT_PASSWORD=changeme
DB_HOST=db
DB_USER=root
DB_PASSWORD=changeme
DB_NAME=espace_comedie

# Backend
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
JWT_SECRET=changeme


# SMTP (ex: mot de passe d'application Gmail — https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=changeme
FROM_EMAIL=noreply@example.com

# Frontend
VITE_API_URL=http://localhost:5000
