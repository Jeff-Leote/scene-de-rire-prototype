# Base de données
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=root
DB_NAME=espace_comedie

# JWT
JWT_SECRET=your_jwt_secret_here

# Email (optionnel)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Upload d'images
SPECTACLE_UPLOAD_DIR=./uploads/spectacles
SPECTACLE_UPLOAD_PUBLIC_PREFIX=/uploads/spectacles

# Cloudinary (pour la production)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=spectacles

# Environnement
NODE_ENV=development
