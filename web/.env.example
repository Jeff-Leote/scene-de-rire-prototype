# Connexion PostgreSQL (Supabase) — pooler, utilisée par l'application en runtime
DATABASE_URL="postgresql://postgres.[ref]:[password]@[host]:6543/postgres?pgbouncer=true"

# Connexion directe — nécessaire pour les migrations Prisma (pgbouncer ne les supporte pas)
DIRECT_URL="postgresql://postgres.[ref]:[password]@[host]:5432/postgres"
