# Connexion PostgreSQL (Supabase) — pooler, utilisée par l'application en runtime
DATABASE_URL="postgresql://postgres.[ref]:[password]@[host]:6543/postgres?pgbouncer=true"

# Connexion directe — nécessaire pour les migrations Prisma (pgbouncer ne les supporte pas)
DIRECT_URL="postgresql://postgres.[ref]:[password]@[host]:5432/postgres"

# SMTP (formulaire de contact) — Gmail par exemple
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="votre-adresse@gmail.com"
SMTP_PASS="mot-de-passe-application"
FROM_EMAIL="votre-adresse@gmail.com"

# Avis Google (bloc "Avis Google" sur l'accueil) — clé serveur uniquement, jamais exposée au navigateur
GOOGLE_PLACES_API_KEY="votre-clé-google-places"
